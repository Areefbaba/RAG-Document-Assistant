# ==========================================
# LLM API Keys & Configuration
# ==========================================
# Default Local LLM: qwen3:4b (via Ollama)
DEFAULT_LLM=qwen3:4b
OLLAMA_HOST=http://127.0.0.1:11434

# OpenAI API Key (for models like gpt-4o, gpt-4o-mini, o1-mini)
OPENAI_API_KEY=

# Groq API Key (for high-speed cloud models like llama-3.3-70b-versatile, mixtral-8x7b-32768)
GROQ_API_KEY=

# Anthropic API Key (for Claude models like claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=

# Google Gemini API Key (for Gemini models like gemini-1.5-flash)
GEMINI_API_KEY=

# ==========================================
# Web Search Configuration
# ==========================================
# Tavily Search API Key (Recommended for high-accuracy RAG web fallback)
# Get a free API key at: https://tavily.com
# If left blank, the system automatically falls back to free DuckDuckGo search
TAVILY_API_KEY=

# ==========================================
# Application Endpoints
# ==========================================
RAG_API_URL=http://127.0.0.1:8000
